opencost:
  prometheus:
    external:
      enabled: true
      url: ${prometheus_url}
    internal:
      enabled: false

  ui:
    enabled: ${enable_ui}
%{ if length(node_selector) > 0 ~}

  nodeSelector:
%{ for k, v in node_selector ~}
    ${k}: "${v}"
%{ endfor ~}
%{ endif ~}

  resources:
    requests:
      cpu: ${requests_cpu}
      memory: ${requests_memory}
    limits:
      cpu: ${limits_cpu}
      memory: ${limits_memory}

%{ if length(extra_labels) > 0 ~}
  extraLabels:
%{ for k, v in extra_labels ~}
    ${k}: "${v}"
%{ endfor ~}
%{ endif ~}

serviceMonitor:
  enabled: ${enable_service_monitor}
%{ if length(extra_labels) > 0 ~}
  additionalLabels:
%{ for k, v in extra_labels ~}
    ${k}: "${v}"
%{ endfor ~}
%{ endif ~}
