opencost:
  prometheus:
    external:
      enabled: true
      url: ${prometheus_url}
    internal:
      enabled: false

  ui:
    enabled: ${enable_ui}
%{ if length(node_selector) > 0 ~}

  nodeSelector: ${jsonencode(node_selector)}
%{ endif ~}

  resources:
    requests:
      cpu: ${resources.requests.cpu}
      memory: ${resources.requests.memory}
    limits:
      cpu: ${resources.limits.cpu}
      memory: ${resources.limits.memory}

%{ if length(extra_labels) > 0 ~}
  extraLabels: ${jsonencode(extra_labels)}
%{ endif ~}

serviceMonitor:
  enabled: ${enable_service_monitor}
%{ if length(extra_labels) > 0 ~}
  additionalLabels: ${jsonencode(extra_labels)}
%{ endif ~}
