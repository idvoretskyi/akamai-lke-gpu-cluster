prometheus:
  prometheusSpec:
    retention: ${prometheus_retention}
    # Accept all ServiceMonitors and PodMonitors regardless of label selectors
    serviceMonitorSelectorNilUsesHelmValues: false
    podMonitorSelectorNilUsesHelmValues: false
%{ if length(node_selector) > 0 ~}
    nodeSelector:
%{ for k, v in node_selector ~}
      ${k}: "${v}"
%{ endfor ~}
%{ endif ~}
    resources:
      requests:
        cpu: ${prometheus_resources.requests.cpu}
        memory: ${prometheus_resources.requests.memory}
      limits:
        cpu: ${prometheus_resources.limits.cpu}
        memory: ${prometheus_resources.limits.memory}
    storageSpec:
      volumeClaimTemplate:
        spec:
          storageClassName: ${storage_class}
          resources:
            requests:
              storage: ${prometheus_storage_size}
%{ if enable_gpu_monitoring ~}
    additionalScrapeConfigs:
      - job_name: dcgm-exporter
        kubernetes_sd_configs:
          - role: endpoints
            namespaces:
              names:
                - gpu-operator
%{ endif ~}

grafana:
  enabled: true
  adminPassword: ${grafana_admin_password}
%{ if length(node_selector) > 0 ~}
  nodeSelector:
%{ for k, v in node_selector ~}
    ${k}: "${v}"
%{ endfor ~}
%{ endif ~}
  resources:
    requests:
      cpu: ${grafana_resources.requests.cpu}
      memory: ${grafana_resources.requests.memory}
    limits:
      cpu: ${grafana_resources.limits.cpu}
      memory: ${grafana_resources.limits.memory}
  persistence:
    enabled: true
    size: ${grafana_storage_size}
    storageClassName: ${storage_class}

alertmanager:
  enabled: true
  alertmanagerSpec:
%{ if length(node_selector) > 0 ~}
    nodeSelector:
%{ for k, v in node_selector ~}
      ${k}: "${v}"
%{ endfor ~}
%{ endif ~}
    resources:
      requests:
        cpu: ${alertmanager_resources.requests.cpu}
        memory: ${alertmanager_resources.requests.memory}
      limits:
        cpu: ${alertmanager_resources.limits.cpu}
        memory: ${alertmanager_resources.limits.memory}
    storage:
      volumeClaimTemplate:
        spec:
          storageClassName: ${storage_class}
          resources:
            requests:
              storage: ${alertmanager_storage_size}

# node-exporter is a DaemonSet that must run on every node (including GPU nodes)
# to export host metrics, so it is intentionally NOT pinned to the system pool.
# Its default tolerations (operator: Exists) let it run on the tainted GPU pool.
nodeExporter:
  enabled: true

kubeStateMetrics:
  enabled: true

%{ if length(node_selector) > 0 ~}
# Pin the Prometheus Operator and kube-state-metrics (subchart) to the system pool.
prometheusOperator:
  nodeSelector:
%{ for k, v in node_selector ~}
    ${k}: "${v}"
%{ endfor ~}
  admissionWebhooks:
    patch:
      nodeSelector:
%{ for k, v in node_selector ~}
        ${k}: "${v}"
%{ endfor ~}

kube-state-metrics:
  nodeSelector:
%{ for k, v in node_selector ~}
    ${k}: "${v}"
%{ endfor ~}
%{ endif ~}
