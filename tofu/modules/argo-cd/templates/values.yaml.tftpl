global:
  domain: argocd.local
%{ if length(node_selector) > 0 ~}
  nodeSelector:
    kubernetes.io/os: linux
%{ for k, v in node_selector ~}
    ${k}: "${v}"
%{ endfor ~}
%{ endif ~}

configs:
  params:
    # Serve plain HTTP. kubectl port-forward does not terminate TLS; it only
    # forwards the connection. The server is reachable solely through that
    # tunnel (ClusterIP, no Ingress), which is authenticated by the Kubernetes
    # API, so the UI is never exposed in cleartext outside the cluster.
    server.insecure: true

# Lab install: local admin only, no SSO or notification controller.
dex:
  enabled: false
notifications:
  enabled: false

controller:
  metrics:
    enabled: ${enable_service_monitor}
    serviceMonitor:
      enabled: ${enable_service_monitor}

server:
  metrics:
    enabled: ${enable_service_monitor}
    serviceMonitor:
      enabled: ${enable_service_monitor}

repoServer:
  metrics:
    enabled: ${enable_service_monitor}
    serviceMonitor:
      enabled: ${enable_service_monitor}

applicationSet:
  metrics:
    enabled: ${enable_service_monitor}
    serviceMonitor:
      enabled: ${enable_service_monitor}
