# Minimal scratch kubeconfig for this module's local-exec kubectl/kustomize
# calls (see main.tf and scripts/install.sh). Intentionally identical to
# modules/hami/templates/kubeconfig.yaml.tftpl — keep both in sync if either
# changes; not worth extracting a shared module for two lines of duplication
# across otherwise-independent, self-contained modules.
apiVersion: v1
kind: Config
clusters:
  - name: lke
    cluster:
      server: "${host}"
      certificate-authority-data: "${ca_cert_b64}"
users:
  - name: lke-user
    user:
      token: "${token}"
contexts:
  - name: lke
    context:
      cluster: lke
      user: lke-user
current-context: lke
