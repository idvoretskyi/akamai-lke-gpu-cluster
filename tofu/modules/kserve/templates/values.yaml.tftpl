kserve:
  controller:
    # Plain Kubernetes Deployments/Services/HPAs; no Knative or Istio.
    deploymentMode: Standard
%{ if length(node_selector) > 0 ~}
    nodeSelector:
%{ for k, v in node_selector ~}
      ${k}: "${v}"
%{ endfor ~}
%{ endif ~}
    gateway:
      # InferenceService URLs become http://<name>-<namespace>.<domain>; the
      # Gateway routes on that Host header.
      domain: ${domain}
      ingressGateway:
        enableGatewayApi: true
        createGateway: true
        kserveGateway: ${namespace}/kserve-ingress-gateway
