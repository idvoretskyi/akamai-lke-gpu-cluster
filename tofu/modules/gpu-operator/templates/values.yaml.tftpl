%{ if length(node_selector) > 0 ~}
operator:
  # Pin the operator controller to the system pool — it needs no GPU itself.
  nodeSelector:
%{ for k, v in node_selector ~}
    ${k}: "${v}"
%{ endfor ~}
%{ endif ~}

%{ if gpu_node_toleration != null ~}
# Let the GPU operands tolerate the GPU node taint so they keep scheduling onto
# the dedicated GPU pool. Uses Exists to match the taint regardless of value.
daemonsets:
  tolerations:
    - key: "${gpu_node_toleration.key}"
      operator: "Exists"
      effect: "${gpu_node_toleration.effect}"
%{ endif ~}

driver:
  enabled: ${install_driver}

toolkit:
  enabled: ${install_toolkit}

devicePlugin:
  enabled: ${device_plugin_enabled}

dcgmExporter:
  enabled: ${enable_dcgm_exporter}

gfd:
  enabled: true

migManager:
  # MIG not supported on RTX 4000 Ada
  enabled: false

nodeStatusExporter:
  enabled: ${enable_node_status_exporter}

# The plugin validator only checks that nvidia.com/gpu is advertised; it does
# not launch a test pod that claims a GPU. With WITH_WORKLOAD=true that pod can
# never run once a model server holds the node's only GPU, and the validator
# retries forever, leaving failed pods behind.
validator:
  plugin:
    env:
      - name: WITH_WORKLOAD
        value: "false"
