nvidia:
  resourceCountName: nvidia.com/gpu
  resourceMemoryName: nvidia.com/gpumem
  resourceMemoryPercentageName: nvidia.com/gpumem-percentage
  resourceCoreName: nvidia.com/gpucores
  resourcePriorityName: nvidia.com/priority
  overwriteEnv: false
  defaultMemory: ${default_gpu_memory}
  defaultCores: 0
  defaultGPUNum: 1
  preConfiguredDeviceMemory: 0
  memoryFactor: 1
  deviceSplitCount: ${device_split_count}
  deviceMemoryScaling: ${device_memory_scaling}
  deviceCoreScaling: ${device_core_scaling}
  gpuCorePolicy: default
  libCudaLogLevel: 1
  runtimeClassName: "${runtime_class_name}"
  # MIG geometries intentionally omitted: this repo's GPU (RTX 4000 Ada) does
  # not support MIG, migStrategy is "none", and the chart's own default list
  # only covers A30/A100/H100/H200/B200 anyway.
  knownMigGeometries: []
