scheduler:
  defaultSchedulerPolicy:
    gpuSchedulerPolicy: "${scheduler_policy}"
  # Anti-affinity is only added by the chart when leaderElect is true, and it
  # deadlocks rolling updates on a single-node system pool (see variables.tf).
  leaderElect: ${scheduler_leader_elect}
  # The chart defaults this sidecar to registry.cn-hangzhou.aliyuncs.com,
  # which is unreachable from some regions (e.g. de-fra-2).
  kubeScheduler:
    image:
      registry: "${kube_scheduler_image_registry}"
      repository: "${kube_scheduler_image_repository}"
%{ if length(node_selector) > 0 ~}
  # Pin the webhook cert-generation job to the system pool — control-plane
  # bits need no GPU. (The scheduler/extender pods themselves are lightweight
  # and the chart does not expose a first-class nodeSelector for them.)
  patch:
    nodeSelector:
%{ for k, v in node_selector ~}
      ${k}: "${v}"
%{ endfor ~}
%{ endif ~}

devicePlugin:
  enabled: true
  deviceSplitCount: ${device_split_count}
  deviceMemoryScaling: ${device_memory_scaling}
  deviceCoreScaling: ${device_core_scaling}
  # Run under an NVIDIA RuntimeClass so the container runtime injects GPU
  # devices/libraries into this pod. On LKE the node image pre-configures the
  # "nvidia" runtime in containerd.
  runtimeClassName: "${runtime_class_name}"
  # Where the NVIDIA driver lives on the host: "/" on the LKE GPU image
  # (pre-installed driver), /run/nvidia/driver for an operator-managed driver.
  nvidiaDriverRoot: "${nvidia_driver_root}"
%{ if wait_for_toolkit_ready ~}
  gpuOperatorToolkitReady:
    enabled: true
    hostPath: "/run/nvidia/validations"
%{ endif ~}
  nvidiaNodeSelector:
%{ for k, v in nvidia_node_selector ~}
    ${k}: "${v}"
%{ endfor ~}
%{ if gpu_node_toleration != null ~}
  # Let the devicePlugin DaemonSet tolerate the GPU node taint so it keeps
  # scheduling onto the dedicated GPU pool. Uses Exists to match the taint
  # regardless of value.
  tolerations:
    - key: "${gpu_node_toleration.key}"
      operator: "Exists"
      effect: "${gpu_node_toleration.effect}"
%{ endif ~}

prometheus:
  enabled: true
