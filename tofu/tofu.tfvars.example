# ============================================================================
# Linode GPU Kubernetes Infrastructure Configuration
# ============================================================================
# Linode API Token is automatically read from the LINODE_TOKEN environment
# variable. No need to set it here.
# To set it: export LINODE_TOKEN="your-personal-access-token"

# ============================================================================
# Cluster Configuration
# ============================================================================

# Cluster name prefix (optional — defaults to your system username)
# cluster_name_prefix = "my-cluster"

# Linode region
region = "us-ord" # Chicago, US

# Kubernetes version (format: 'X.Y')
kubernetes_version = "1.34"

# GPU node configuration
# NVIDIA RTX 4000 Ada x1 Small: 1 GPU, 4 vCPU, 16 GB RAM, 512 GB SSD
gpu_node_type  = "g2-gpu-rtx4000a1-s"
gpu_node_count = 1

# Autoscaling range
autoscaler_min = 1
autoscaler_max = 5

# High availability control plane
ha_control_plane = true

# Resource tags applied to Linode resources
tags = ["lke", "gpu", "ml", "ai"]

# ============================================================================
# Security (restrict IPs in production)
# ============================================================================

allowed_kubectl_ips    = ["0.0.0.0/0"]
allowed_monitoring_ips = ["0.0.0.0/0"]

# ============================================================================
# Kubeconfig
# ============================================================================

# Automatically merge cluster kubeconfig into ~/.kube/config.
# Set to false in CI pipelines or when managing kubeconfig externally.
merge_kubeconfig = true

# ============================================================================
# GPU Operator
# ============================================================================

install_gpu_operator  = true
gpu_operator_version  = "v24.9.0"
enable_gpu_monitoring = true

# ============================================================================
# Metrics Server
# ============================================================================

install_metrics_server = true

# ============================================================================
# Monitoring Stack (Prometheus + Grafana + Alertmanager)
# ============================================================================

install_monitoring        = true
grafana_admin_password    = "admin" # Change in production!
prometheus_retention      = "15d"
prometheus_storage_size   = "50Gi"
alertmanager_storage_size = "10Gi"
grafana_storage_size      = "10Gi"

# ============================================================================
# Example Configurations
# ============================================================================

# Development / Testing (minimal resources):
# gpu_node_count            = 1
# autoscaler_max            = 2
# install_gpu_operator      = true
# install_monitoring        = true
# prometheus_storage_size   = "25Gi"
# alertmanager_storage_size = "5Gi"

# Production AI Platform (full setup):
# gpu_node_count            = 2
# autoscaler_max            = 5
# install_gpu_operator      = true
# enable_gpu_monitoring     = true
# install_metrics_server    = true
# install_monitoring        = true
# prometheus_retention      = "30d"
# prometheus_storage_size   = "100Gi"
# alertmanager_storage_size = "10Gi"
# grafana_admin_password    = "your-secure-password-here"

# Security-hardened setup:
# allowed_kubectl_ips    = ["YOUR_IP/32"]
# allowed_monitoring_ips = ["YOUR_IP/32"]
# ha_control_plane       = true
