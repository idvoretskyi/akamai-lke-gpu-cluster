# ============================================================================
# Linode GPU Kubernetes Lab — Configuration
# ============================================================================
# Copy this file to tofu.tfvars and adjust as needed.
#
# Linode API token: auto-resolved from the default user in
# ~/.config/linode-cli if present (takes priority), else from the
# LINODE_TOKEN environment variable:
#   export LINODE_TOKEN="your-token"

# ============================================================================
# Cluster
# ============================================================================

# cluster_name_prefix = "my-cluster"  # optional — defaults to system username
# RTX 4000 Ada (g2-gpu-*) is NOT available in gb-lon. EU regions that offer it:
# de-fra-2 (Frankfurt 2), fr-par (Paris). Re-check availability with:
#   linode-cli regions list-avail --json --all-rows | jq -r '.[] | select(.plan|startswith("g2-gpu")) | select(.available) | .region' | sort -u
region             = "de-fra-2" # Frankfurt 2, DE
kubernetes_version = "1.36"
ha_control_plane   = false
tags               = ["lke", "gpu", "ml", "ai"]

# ============================================================================
# GPU Node Pool
# ============================================================================
# Cheapest Linode GPU: NVIDIA RTX 4000 Ada x1 Small (~$0.52/hr, ~$380/month)
# List available GPU plans:
#   linode-cli linodes types --json | jq '.[] | select(.class=="gpu")'

gpu_node_type  = "g2-gpu-rtx4000a1-s"
gpu_node_count = 1

# ============================================================================
# System Node Pool
# ============================================================================
# Small CPU pool for monitoring and system workloads (~$24/month).
# Use g6-standard-8 if enabling install_kubeflow (measured usage with the
# full stack is ~9-10 GB; see modules/kubeflow).
# List shared-CPU plans:
#   linode-cli linodes types --json | jq '.[] | select(.class=="standard")'

system_node_type   = "g6-standard-2"
system_node_count  = 1
dedicate_gpu_nodes = true

# ============================================================================
# Networking
# ============================================================================

allowed_kubectl_ips = ["0.0.0.0/0"]

# node_cidrs = ["192.168.128.0/17"]  # LKE private node range (rarely needs changing)
# pod_cidrs  = ["10.2.0.0/16"]       # LKE pod CIDR (rarely needs changing)

# ============================================================================
# Kubeconfig
# ============================================================================

merge_kubeconfig = true

# ============================================================================
# GPU Operator
# ============================================================================

install_gpu_operator  = true
gpu_operator_version  = "v26.7.1"
enable_gpu_monitoring = true

# ============================================================================
# HAMi (GPU Virtualization) — lab default: enabled
# ============================================================================
# Splits each physical GPU into vGPU slices so multiple pods can share one
# GPU. Disables the GPU Operator's stock device plugin when enabled.

install_hami            = true
hami_version            = "2.9.0"
hami_device_split_count = 10
# vGPU memory (MB) given to nvidia.com/gpu requests with no explicit gpumem
# (e.g. Kubeflow Pipelines components, which have no way to set gpumem via
# the kfp SDK). 0 = whole physical GPU for such requests (HAMi's own default).
hami_default_gpu_memory = 8000

# ============================================================================
# Kubeflow — opt-in, heavy
# ============================================================================
# Installs via kustomize + kubectl apply (no full-platform Helm chart
# upstream). Recommend system_node_type = "g6-standard-8" when enabling
# (measured usage with the full stack is ~9-10 GB).

install_kubeflow = false
kubeflow_ref     = "master"

# ============================================================================
# Metrics Server
# ============================================================================

install_metrics_server = true
# metrics_server_version = "3.12.2"

# ============================================================================
# Monitoring Stack (Prometheus + Grafana)
# ============================================================================

install_monitoring = true
# kube_prometheus_stack_version = "80.8.0"
grafana_admin_password  = "admin"
prometheus_retention    = "7d"
prometheus_storage_size = "15Gi" # ~$1.50/month
grafana_storage_size    = "5Gi"  # ~$0.50/month

# Optional: override default CPU/memory requests+limits (defaults shown)
# prometheus_resources = {
#   requests = { cpu = "200m", memory = "512Mi" }
#   limits   = { cpu = "1000m", memory = "2Gi" }
# }
# grafana_resources = {
#   requests = { cpu = "50m", memory = "128Mi" }
#   limits   = { cpu = "200m", memory = "512Mi" }
# }

# ============================================================================
# Cost Monitoring (OpenCost)
# ============================================================================

install_opencost = true
opencost_version = "2.5.14"

# ============================================================================
# Ollama (LLM serving)
# ============================================================================
# Serves local LLMs from the GPU node. Reach it with:
#   kubectl port-forward -n ollama service/ollama 11434:11434
# Fit on an RTX 4000 Ada (20 GB VRAM), download size in brackets:
#   gpt-oss:20b (14 GB), gemma4:12b (7.7 GB), qwen3.5:9b (6.6 GB) — comfortable
#   qwen3.8:27b (18 GB), gemma4:26b (16 GB) — tight, 8K context
#   Kimi K2 / DeepSeek V3 / GLM-5 — far too large (cloud-only in Ollama)
# Ollama takes the whole GPU; set install_ollama = false to free it.

install_ollama      = true
ollama_models       = ["gpt-oss:20b", "gemma4:12b", "qwen3.5:9b", "qwen3.8:27b"]
ollama_storage_size = "80Gi" # ~$8/month
# ollama_version        = "1.84.0"
# ollama_gpu_memory_mib = 20000 # whole GPU; ignored without HAMi
# ollama_context_length = 8192

# ============================================================================
# vLLM (OpenAI-compatible serving for opencode and other coding agents)
# ============================================================================
# One model, the whole GPU, API key required. Only one GPU server at a time:
# set install_ollama = false (and install_llamacpp = false) when enabling it.
# Reach it with:
#   kubectl port-forward -n vllm service/vllm-coder-engine-service 8000:8000
#   tofu output -raw vllm_api_key
# Presets: gpt-oss-20b (MXFP4, 64K context, default) or qwen3-coder-30b
# (AWQ 4-bit, 32K context). See examples/vllm-opencode.

install_vllm = false
# vllm_model_profile       = "gpt-oss-20b"
# vllm_model_repo          = null  # override the preset's Hugging Face repo
# vllm_served_model_name   = null
# vllm_max_model_len       = null
# vllm_extra_args          = []
# vllm_version             = "0.1.13"
# vllm_image_tag           = "v0.30.0"
# vllm_api_key             = null  # null generates one; or TF_VAR_vllm_api_key
# hf_token                 = null  # only for gated models; or TF_VAR_hf_token
# vllm_cache_size          = "50Gi" # ~$5/month while the cluster exists
# vllm_cache_storage_class = "linode-block-storage" # "-retain" keeps weights across destroy, but stays billed

# ============================================================================
# llama.cpp (optional GGUF server)
# ============================================================================
# For models vLLM cannot fit, e.g. dense Qwen3.8-27B at 4-bit (16.5 GB GGUF).
# Same local port and client setup as vLLM:
#   kubectl port-forward -n llamacpp service/llamacpp 8000:8080
#   tofu output -raw llamacpp_api_key

install_llamacpp = false
# llamacpp_gguf_repo         = "unsloth/Qwen3.8-27B-GGUF:UD-Q4_K_M"
# llamacpp_served_model_name = "qwen3.8-27b"
# llamacpp_context_size      = 32768
# llamacpp_n_cpu_moe         = 0 # MoE: expert layers kept in host RAM
# llamacpp_n_cpu_ffn         = 0 # dense: FFN layers kept in host RAM
# llamacpp_extra_args        = []
# llamacpp_image_tag         = "server-cuda-v0.5.0"
# llamacpp_api_key           = null # null generates one
# llamacpp_cache_size        = "40Gi"

# ============================================================================
# Cost Management
# ============================================================================
# Destroy the cluster to stop paying for compute:
#   tofu destroy
# Re-create when needed:
#   tofu apply
