# ============================================================================
# LKE + KServe GPU reference architecture — Configuration
# ============================================================================
# Copy this file to tofu.tfvars and adjust as needed.
#
# Linode API token: auto-resolved from the default user in
# ~/.config/linode-cli if present (takes priority), else from the
# LINODE_TOKEN environment variable:
#   export LINODE_TOKEN="your-token"

# ============================================================================
# Cluster
# ============================================================================

# cluster_name_prefix = "my-cluster"  # optional — defaults to system username
# RTX 4000 Ada (g2-gpu-*) is NOT available in gb-lon. EU regions that offer it:
# de-fra-2 (Frankfurt 2), fr-par (Paris). Re-check availability with:
#   linode-cli regions list-avail --json --all-rows | jq -r '.[] | select(.plan|startswith("g2-gpu")) | select(.available) | .region' | sort -u
region             = "de-fra-2" # Frankfurt 2, DE
kubernetes_version = "1.36"
ha_control_plane   = false
tags               = ["lke", "gpu", "ml", "ai"]

# ============================================================================
# GPU Node Pool
# ============================================================================
# Cheapest Linode GPU: NVIDIA RTX 4000 Ada x1 Small (~$0.52/hr, ~$380/month)
# List available GPU plans:
#   linode-cli linodes types --json | jq '.[] | select(.class=="gpu")'

gpu_node_type  = "g2-gpu-rtx4000a1-s"
gpu_node_count = 1

# ============================================================================
# System Node Pool
# ============================================================================
# CPU pool for the platform: monitoring, cert-manager, Envoy Gateway, KServe
# controller, Argo CD (~$48/month). g6-standard-2 (4 GB) is too small for it.
# List shared-CPU plans:
#   linode-cli linodes types --json | jq '.[] | select(.class=="standard")'

system_node_type   = "g6-standard-4"
system_node_count  = 1
dedicate_gpu_nodes = true

# ============================================================================
# Networking
# ============================================================================

allowed_kubectl_ips = ["0.0.0.0/0"]

# node_cidrs = ["192.168.128.0/17"]  # LKE private node range (rarely needs changing)
# pod_cidrs  = ["10.2.0.0/16"]       # LKE pod CIDR (rarely needs changing)

# ============================================================================
# Kubeconfig
# ============================================================================

merge_kubeconfig = true

# ============================================================================
# GPU Operator
# ============================================================================

install_gpu_operator  = true
gpu_operator_version  = "v26.7.1"
enable_gpu_monitoring = true

# ============================================================================
# Metrics Server
# ============================================================================

install_metrics_server = true
# metrics_server_version = "3.12.2"

# ============================================================================
# Monitoring Stack (Prometheus + Grafana)
# ============================================================================

install_monitoring = true
# kube_prometheus_stack_version = "80.8.0"
grafana_admin_password  = "admin"
prometheus_retention    = "7d"
prometheus_storage_size = "15Gi" # ~$1.50/month
grafana_storage_size    = "5Gi"  # ~$0.50/month
# Deleted with the cluster. Upgrading a cluster created with the old
# "linode-block-storage-retain" default in place? Set that value here: a PVC's
# storage class can't be changed (see README "Upgrading an existing cluster").
# monitoring_storage_class = "linode-block-storage"

# Optional: override default CPU/memory requests+limits (defaults shown)
# prometheus_resources = {
#   requests = { cpu = "200m", memory = "512Mi" }
#   limits   = { cpu = "1000m", memory = "2Gi" }
# }
# grafana_resources = {
#   requests = { cpu = "50m", memory = "128Mi" }
#   limits   = { cpu = "200m", memory = "512Mi" }
# }

# ============================================================================
# Model Serving — KServe (Standard mode) + vLLM, behind Envoy Gateway
# ============================================================================
# Also installs cert-manager (KServe webhook TLS) and Envoy Gateway (Gateway
# API). The model itself is not configured here: Argo CD syncs it from
# gitops/vllm (see the GitOps section). Fits on an RTX 4000 Ada (20 GB):
#   Qwen/Qwen3-8B-FP8 (default, ~9 GB weights, 32k context)
#   Qwen/Qwen3-14B-FP8 (~16 GB weights, lower --max-model-len, ~8k)

install_kserve = true
# kserve_version        = "v0.20.0"
# cert_manager_version  = "v1.21.2"
# envoy_gateway_version = "v1.9.2"
# kserve_ingress_domain = "kserve.local"
# model_namespace       = "vllm"

# ClusterIP keeps the unauthenticated model endpoint private (kubectl
# port-forward). LoadBalancer exposes it on a public NodeBalancer (~$10/month).
gateway_service_type = "ClusterIP"

# ============================================================================
# GitOps — Argo CD
# ============================================================================
# Bootstraps the "vllm" Application, which syncs gitops_path from
# gitops_repo_url. Fork the repo (or point at a branch) to change the model.
# UI: kubectl port-forward -n argocd svc/argo-cd-argocd-server 8080:80

install_argo_cd = true
# argo_cd_version        = "10.10.1"
# gitops_repo_url        = "https://github.com/idvoretskyi/akamai-lke-gpu-cluster.git"
# gitops_target_revision = "main"
# gitops_path            = "gitops/vllm"

# ============================================================================
# Cost Management
# ============================================================================
# Destroy the cluster to stop paying for compute:
#   tofu destroy
# Re-create when needed:
#   tofu apply
