# ============================================================================
# Linode GPU Kubernetes Infrastructure Configuration
# ============================================================================
# Linode API Token is automatically read from the LINODE_TOKEN environment
# variable. No need to set it here.
# To set it: export LINODE_TOKEN=$(linode-cli configure get token)

# ============================================================================
# Cluster Configuration
# ============================================================================

# Cluster name prefix (optional — defaults to your system username)
# cluster_name_prefix = "my-cluster"

# Linode region
region = "us-ord" # Chicago, US

# Kubernetes version (format: 'X.Y')
kubernetes_version = "1.35"

# High availability control plane.
# Set true for production (~$60/month extra). Default false for cost savings.
ha_control_plane = false

# Resource tags applied to Linode resources
tags = ["lke", "gpu", "ml", "ai"]

# ============================================================================
# GPU Node Configuration
# ============================================================================
# Cheapest Linode GPU: NVIDIA RTX 4000 Ada x1 Small
#   SKU:    g2-gpu-rtx4000a1-s
#   Specs:  1 GPU, 4 vCPU, 16 GB RAM, 512 GB SSD
#   Cost:   ~$0.52/hr (~$380/month per node)
#
# List all available GPU plans:
#   linode-cli linodes types --json | jq '.[] | select(.class=="gpu")'

gpu_node_type  = "g2-gpu-rtx4000a1-s"
gpu_node_count = 1

# Autoscaling range (cost floor = autoscaler_min nodes at rest)
autoscaler_min = 1
autoscaler_max = 5

# ============================================================================
# System Node Pool (dedicated CPU nodes for the system/monitoring stack)
# ============================================================================
# A small, cheap CPU pool hosts the cluster's "system" workloads (Prometheus,
# Grafana, Alertmanager, kube-state-metrics, metrics-server, OpenCost, and the
# GPU Operator controller). This keeps the expensive GPU node reserved purely
# for GPU-intensive workloads.
#
# List shared-CPU plans:
#   linode-cli linodes types --json | jq '.[] | select(.class=="standard")'

system_node_type      = "g6-standard-2" # 2 vCPU, 4 GB RAM (~$24/month)
system_node_count     = 1
system_autoscaler_min = 1
system_autoscaler_max = 2

# Taint the GPU pool (nvidia.com/gpu=present:NoSchedule) so only workloads that
# tolerate it land there. Set false to allow general workloads on GPU nodes.
# GPU workloads must add a matching toleration — see README.
dedicate_gpu_nodes = true

# ============================================================================
# Security (restrict IPs in production)
# ============================================================================

allowed_kubectl_ips    = ["0.0.0.0/0"]
allowed_monitoring_ips = ["0.0.0.0/0"]

# ============================================================================
# Kubeconfig
# ============================================================================

# Automatically merge cluster kubeconfig into ~/.kube/config.
# Set to false in CI pipelines or when managing kubeconfig externally.
merge_kubeconfig = true

# ============================================================================
# GPU Operator
# ============================================================================

install_gpu_operator  = true
gpu_operator_version  = "v24.9.0"
enable_gpu_monitoring = true

# ============================================================================
# Metrics Server
# ============================================================================

install_metrics_server = true

# ============================================================================
# Monitoring Stack (Prometheus + Grafana + Alertmanager)
# ============================================================================

install_monitoring = true

grafana_admin_password = "admin" # Change in production!

# Default lowered for cost-efficient dev/test. Raise to "30d" for production.
prometheus_retention = "7d"

# Storage sizes — Linode block storage costs ~$0.10/GB/month.
# Defaults are sized for cost-efficient dev/test use.
# For production, increase prometheus_storage_size to 50Gi+.
prometheus_storage_size   = "15Gi" # ~$1.50/month
alertmanager_storage_size = "5Gi"  # ~$0.50/month
grafana_storage_size      = "5Gi"  # ~$0.50/month

# Optional: tune monitoring stack resource requests/limits to fit on a single
# GPU node alongside workloads. Defaults are conservative; raise for high
# cardinality / production. Example:
# prometheus_resources = {
#   requests = { cpu = "500m", memory = "2Gi" }
#   limits   = { cpu = "2000m", memory = "8Gi" }
# }

# ============================================================================
# Cost Monitoring (OpenCost)
# ============================================================================

install_opencost       = true
opencost_chart_version = "2.5.14"

# ============================================================================
# Cost Guardrails
# ============================================================================

# Warn (non-blocking) when gpu_node_type is outside the known cost-efficient
# allowlist. Set false to silence after intentionally picking a larger plan.
warn_on_non_default_gpu = true

# Soft monthly cost ceiling (USD). Coarse estimate over GPU nodes + HA flag;
# storage and egress not included. Advisory only.
cost_ceiling_usd_per_month = 500

# ============================================================================
# Pause / Resume (no Terraform changes)
# ============================================================================
# To stop paying for GPU compute without destroying the cluster (the small
# system pool keeps running so the cluster stays manageable):
#   tofu/scripts/suspend-cluster.sh "$(tofu output -raw cluster_id)" "$(tofu output -raw gpu_node_pool_id)"
# To resume:
#   tofu/scripts/resume-cluster.sh "$(tofu output -raw cluster_id)" "$(tofu output -raw gpu_node_pool_id)" 1
# Note: LKE autoscaler requires min >= 1, so these scripts bypass the
# autoscaler via linode-cli. Run `tofu apply -refresh-only` afterwards
# to reconcile state, or temporarily set gpu_node_count = 0 in tfvars.

# ============================================================================
# Example Configurations
# ============================================================================

# Minimum cost setup (single GPU node, no HA):
# gpu_node_count            = 1
# autoscaler_max            = 2
# system_node_type          = "g6-standard-2"  # ~$24/month
# system_node_count         = 1
# ha_control_plane          = false   # saves ~$60/month
# prometheus_retention      = "7d"
# prometheus_storage_size   = "15Gi"
# alertmanager_storage_size = "5Gi"
# grafana_storage_size      = "5Gi"
# Estimated total: ~$406/month (1 GPU node + 1 system node + ~$2 storage)

# Production AI Platform (full setup):
# gpu_node_count            = 2
# autoscaler_max            = 5
# system_node_type          = "g6-standard-4"  # more headroom for monitoring
# system_autoscaler_max     = 3
# ha_control_plane          = true
# install_gpu_operator      = true
# enable_gpu_monitoring     = true
# install_metrics_server    = true
# install_monitoring        = true
# install_opencost          = true
# prometheus_retention      = "30d"
# prometheus_storage_size   = "100Gi"
# alertmanager_storage_size = "10Gi"
# grafana_admin_password    = "your-secure-password-here"

# Security-hardened setup:
# allowed_kubectl_ips    = ["YOUR_IP/32"]
# allowed_monitoring_ips = ["YOUR_IP/32"]
# ha_control_plane       = true
