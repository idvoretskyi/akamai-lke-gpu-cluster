# Local .terraform and .tofu directories
**/.terraform/*
**/.tofu/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc
.tofurc
tofu.rc

# Note: .terraform.lock.hcl files are committed to ensure consistent provider versions
# This is the recommended approach for Terraform/OpenTofu projects

# Scratch kubeconfig files written by modules/hami and modules/kubeflow for
# their local-exec provisioners (kubectl rollout restart / kustomize apply).
# The cluster's own kubeconfig is separately merged into ~/.kube/config by
# the root module's terraform_data.merge_kubeconfig, not written here.
.kubeconfig-*
