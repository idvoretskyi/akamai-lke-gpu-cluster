# OpenTofu / Terraform
**/.terraform/*
**/.tofu/*
*.tfstate
*.tfstate.*
*.tfplan
tfplan
*.tfplan.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
.tofurc
tofu.rc

# Note: .terraform.lock.hcl files are tracked for consistent provider versions

# Sensitive configuration files
*.tfvars
*.tfvars.json
!*.tfvars.example

# Kubeconfig files
kubeconfig*.yaml
*.kubeconfig
.kubeconfig-*
.kube/

# Kubeflow module scratch clone dir (git clone of upstream manifests at apply time)
tofu/modules/kubeflow/.work/

# Compiled Kubeflow Pipelines IR (examples/roboflow-pipeline)
examples/roboflow-pipeline/pipeline.yaml

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store

# Logs and local temp files
*.log
*.tmp
*.bak

# Environment files
.env
.env.local
