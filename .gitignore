# OpenTofu / Terraform
**/.terraform/*
**/.tofu/*
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
.tofurc
tofu.rc

# .terraform.lock.hcl files are tracked for consistent provider versions

# Real configuration (may hold secrets); only the .example is tracked
*.tfvars
*.tfvars.json
!*.tfvars.example

# Kubeconfigs. .kubeconfig-* covers the token-bearing scratch file the removed
# HAMi module wrote (tofu/modules/hami/.kubeconfig-hami); it can still be on
# disk in checkouts that predate the KServe rebuild, so keep it ignored.
kubeconfig*.yaml
*.kubeconfig
.kubeconfig-*
.kube/

# Editors, OS, Python bytecode, local env
.idea/
.vscode/
*.swp
.DS_Store
__pycache__/
*.py[cod]
.env
.env.*

# Local AI-assistant state
.claude/
.opencode/
